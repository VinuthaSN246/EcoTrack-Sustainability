# EcoTrack Backend Environment Variables
HOST=0.0.0.0
PORT=5001
# Local default. Use a PostgreSQL URL in production, for example:
# DATABASE_URL=postgresql+psycopg://user:password@host:5432/ecotrack
DATABASE_URL=sqlite:///ecotrack.db
SECRET_KEY=replace-with-a-long-random-secret
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
COOKIE_SECURE=false
FLASK_ENV=development
